# Секретные конфигурационные файлы (содержат пароли от локальной БД)
# Внимание: для проверки преподавателем config.php обычно оставляют, 
# но если там ваши личные пароли — его скрывают. Если решите скрыть, удалите решетку ниже:
# config.php

# Временные файлы операционной системы и редакторов кода
.DS_Store
Thumbs.db
Desktop.ini

# Настройки IDE / Редакторов кода (VS Code, PHPStorm)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Логи сервера и отчеты об ошибках
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Кэш и загружаемые файлы (если появятся в будущем)
/vendor/
/node_modules/